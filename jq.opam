license: "MIT"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.22" & >= "3.22"}
  "core"
  "core_unix"
  "jsonaf"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
