opam-version: "2.0"
synopsis: "OCaml bindings to libjq for JSON querying and pretty-printing"
description: """
OCaml bindings to libjq (vendored). Provides a thin wrapper around the
libjq C API for compiling and running jq programs over JSON values.

The vendored libjq build assumes glibc + Linux for portability of the
math/time functions it uses."""
maintainer: ["Mt <mtakeda@oeconomia.jp>"]
authors: ["Mt <mtakeda@oeconomia.jp>"]
license: "MIT"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.22" & >= "3.22"}
  "core"
  "core_unix"
  "jsonaf"
  "ppx_jane"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
available: os = "linux"
