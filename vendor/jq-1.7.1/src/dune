; Generate the embedded builtin.jq source string the same way the upstream
; autotools build does: escape backslashes and quotes, wrap each line in
; quotes with a trailing \n. The output is dropped under src/ so that the
; "src/builtin.inc" include path in builtin.c resolves correctly relative
; to that source file.

(subdir
 src
 (rule
  (target builtin.inc)
  (deps ../builtin.jq)
  (action
   (with-stdout-to
    %{target}
    (bash
     "sed -e 's/\\\\/\\\\\\\\/g' -e 's/\"/\\\\\"/g' -e 's/^/\"/' -e 's/$/\\\\n\"/' %{dep:../builtin.jq}")))))

(foreign_library
 (archive_name jq_main)
 (language c)
 (names
  builtin
  bytecode
  compile
  execute
  jv
  jv_alloc
  jv_aux
  jv_dtoa
  jv_dtoa_tsd
  jv_file
  jv_parse
  jv_print
  jv_unicode
  lexer
  linker
  locfile
  parser
  util)
 (extra_deps src/builtin.inc)
 (flags
  :standard
  -D_GNU_SOURCE
  -DIEEE_8087=1
  -DHAVE_PTHREAD=1
